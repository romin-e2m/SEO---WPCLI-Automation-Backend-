# =========================================
# Backend Internal Configuration Only
# =========================================
# NOTE: WordPress credentials and site-specific configs
# are provided by the FRONTEND in request payloads.
# Backend is site-agnostic and works with any WordPress site.

# Server
NODE_ENV=development
PORT=8013
LOG_LEVEL=debug

# CORS: Comma-separated browser origins allowed to call this API.
# Frontend UI runs on port 3013 (Vite dev or Docker nginx).
CORS_ALLOWED_ORIGINS=http://localhost:3013,http://127.0.0.1:3013

# Request timeout (milliseconds)
REQUEST_TIMEOUT=30000

# Rate limiting (optional, not required for MVP)
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# WordPress REST client: minimum delay (seconds) between successive requests
WP_REST_RATE_LIMIT_DELAY_SEC=0.5

# Playwright UI automation: directory for failure screenshots
PLAYWRIGHT_SCREENSHOTS_DIR=/tmp/playwright_screenshots

# SSE /system/execution/stream: poll interval (sec) and max stream duration (sec)
SSE_EXECUTION_STREAM_POLL_INTERVAL_SEC=0.5
SSE_EXECUTION_STREAM_MAX_DURATION_SEC=300

