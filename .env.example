# Comma-separated browser origins allowed to call this API (CORS).
# Local UI runs on port 3013 (Vite dev or Docker nginx).
CORS_ALLOWED_ORIGINS=http://localhost:3013,http://127.0.0.1:3013

# Note: in this repo the single source of truth is `docs/.env.master` (not committed).
# Generate `frontend/.env` and `backend/.env` by running:
#   bash docs/sync_env.sh
