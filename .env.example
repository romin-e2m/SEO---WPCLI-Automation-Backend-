# =========================================
# Backend Internal Configuration Only
# =========================================
# NOTE: WordPress credentials and site-specific configs
# are provided by the FRONTEND in request payloads.
# Backend is site-agnostic and works with any WordPress site.

# Server
NODE_ENV=development
PORT=8013
LOG_LEVEL=debug

# CORS: Comma-separated browser origins allowed to call this API.
# Frontend UI runs on port 3013 (Vite dev or Docker nginx).
CORS_ALLOWED_ORIGINS=http://localhost:3013,http://127.0.0.1:3013

# Request timeout (milliseconds)
REQUEST_TIMEOUT=30000

# Rate limiting (optional, not required for MVP)
RATE_LIMIT_REQUESTS_PER_MINUTE=60

